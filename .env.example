# Copy to ~/.config/thetaterm/.env (or .env here for `uv run --env-file .env`). All settings are optional.
THETATERM_MODEL=gemma4:e4b-mlx
# Any OpenAI-compatible endpoint; the default is Ollama.
THETATERM_BASE_URL=http://localhost:11434/v1
# Only for servers that require a key.
THETATERM_API_KEY=

# --- UpSkill feedback loop (optional) ---
# Set to 1 to log declined/failed commands locally to ~/.config/thetaterm/failures.jsonl
# THETATERM_LOG_FAILURES=1
# Student model to validate skills against (defaults to THETATERM_MODEL)
# THETATERM_UPSKILL_STUDENT=gemma4:e4b-mlx
# Teacher backend: auto | claude | openrouter | openai
# THETATERM_UPSKILL_TEACHER_BACKEND=claude
# Teacher model (e.g. opus, anthropic/claude-opus-4, or a local model with backend=openai)
# THETATERM_UPSKILL_TEACHER=opus
# Only needed when THETATERM_UPSKILL_TEACHER_BACKEND=openai (e.g. http://localhost:11434/v1)
# THETATERM_UPSKILL_TEACHER_BASE_URL=
# THETATERM_UPSKILL_TEACHER_API_KEY=
